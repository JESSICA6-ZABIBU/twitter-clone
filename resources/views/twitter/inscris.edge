<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>inscription</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-black min-h-screen flex items-center justify-center">

    <div class="flex flex-col lg:flex-row items-center justify-center gap-8 p-4 w-full max-w-7xl">
  
      <!-- Logo X -->
      <div class="p-4 bg-black rounded shadow">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 1227" class="w-32 h-32 lg:w-80 lg:h-80 text-white">
          <path fill="currentColor" d="M714.15 560.82 1167.99 0H1060.1L666.04 486.52 344.33 0H0l476.91 714.57L0 1227h107.88l418.79-516.15L867.25 1227H1200L714.15 560.82ZM589.47 689.35l-48.42-71.44L146.32 82.28h150.5l259.65 382.61 48.42 71.45L1053.68 1145h-150.5L589.47 689.35Z"/>
        </svg>
      </div>
  
      <!-- Formulaire d'inscription -->
      <div class="bg-black p-6 sm:p-8 rounded-2xl shadow-lg w-full max-w-md text-white">
        
        <!-- Petit logo -->
        <img src="/public/images/téléchargement.png" class="w-10 h-auto mb-4" alt="logo">
  
        <!-- Titres -->
        <div class="mb-6">
          <h1 class="text-3xl font-bold">Se passe maintenant</h1>
          <h3 class="text-xl mt-2 text-gray-300">Inscrivez-vous dès aujourd’hui.</h3>
        </div>
  
        <!-- Bouton Google -->
        <a href="#" class="flex items-center justify-center w-full space-x-2 px-6 py-2 bg-white text-black border border-gray-300 rounded-full shadow hover:bg-gray-100 mb-4">
            <svg class="w-5 h-5" viewBox="0 0 48 48">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.61 1.23 9.07 3.25l6.76-6.76C35.25 2.3 29.95 0 24 0 14.64 0 6.82 5.8 2.93 14.1l7.88 6.12C12.66 13.94 17.9 9.5 24 9.5z"/>
              <path fill="#34A853" d="M46.13 24.55c0-1.4-.12-2.76-.34-4.05H24v7.68h12.44c-.54 2.9-2.16 5.37-4.57 7.05l7.1 5.5C43.96 36.63 46.13 30.94 46.13 24.55z"/>
              <path fill="#4A90E2" d="M9.57 28.22a14.74 14.74 0 0 1 0-8.45l-7.88-6.12C.63 17.22 0 20.52 0 24c0 3.48.63 6.78 1.7 9.88l7.87-5.66z"/>
              <path fill="#FBBC05" d="M24 48c6.49 0 11.94-2.15 15.92-5.84l-7.1-5.5c-2.01 1.34-4.57 2.12-8.82 2.12-6.1 0-11.34-4.44-13.18-10.72L2.93 33.9C6.82 42.2 14.64 48 24 48z"/>
            </svg>
            <span class="font-medium">S’inscrire avec Google</span>
        </a>
          
  
        <!-- Bouton Apple -->
        <a href="#" class="flex items-center justify-center w-full space-x-2 px-6 py-2 bg-white text-black border border-gray-300 rounded-full shadow hover:bg-gray-100 mb-4">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M16.7 1.9c0 1.5-.8 3-2 3.9-.9.8-2 1.3-3.1 1.1-.1-1.3.5-2.5 1.3-3.3.9-.9 2.4-1.5 3.8-1.7zm3.5 16.7c-.4.9-.9 1.7-1.5 2.5-.8 1.1-1.7 2.1-2.9 2.1-1.1 0-1.4-.7-2.9-.7s-1.9.7-2.9.7c-1.2 0-2.1-1-2.9-2.1-2-2.8-3.5-7.9-1.5-11.4.9-1.6 2.5-2.5 4.1-2.5 1.2 0 2.3.8 2.9.8.6 0 1.9-1 3.2-.8 1.1.1 2.1.6 2.9 1.4-2.5 1.6-2.1 5 .5 6.1z"/>
            </svg>
            <span class="font-medium">S’inscrire avec Apple</span>
          </a>
          
  
        <!-- Séparateur -->
        <div class="flex items-center my-4">
          <div class="flex-grow border-t border-gray-600"></div>
          <span class="mx-2 text-gray-400">ou</span>
          <div class="flex-grow border-t border-gray-600"></div>
        </div>
  
        <!-- Bouton Créer un compte -->
        <button class="w-full bg-white hover:bg-blue-600 text-black font-semibold py-2 px-4 rounded-full shadow mb-4 transition">
          Créer un compte
        </button>
  
        <!-- Texte conditions -->
        <p class="text-xs text-gray-400 mb-4">
          En vous inscrivant, vous acceptez les <a href="#" class="underline text-blue-400">conditions d’utilisation</a> et la <a href="#" class="underline text-blue-400">politique de confidentialité</a>, y compris <a href="#" class="underline text-blue-400">l’utilisation des cookies</a>.
        </p>
  
        <!-- Lien vers connexion -->
        <div class="flex flex-wrap gap-1 text-sm text-gray-300">
          <span>Vous avez déjà un compte ?</span>
          <a href="#" class="text-blue-400 hover:underline">S’identifier</a>
        </div>
      </div>
    </div>
  
  </body>
  </html>