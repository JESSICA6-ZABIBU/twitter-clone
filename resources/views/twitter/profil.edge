<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profil - Twitter Clone</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
</head>
<body class="bg-black text-white">

  <!-- En-tête -->

  <header class="border-b border-gray-700 p-4 flex items-center justify-between">
    <a href="/" class="font-bold text-xl">← Accueil</a>
    <h1 class="text-xl font-bold">Profil</h1>
  </header>

  <!-- Section Profil -->
  <section class="p-6">
    <div class="flex items-center gap-4">
      <img src="{{ asset('images/Profile-Photo.png') }}" alt="Avatar" class="w-24 h-24 rounded-full border-4 border-blue-500" />
      <div>
        <h2 class="text-2xl font-bold">Jessica Zabibu</h2>
        <p class="text-gray-400">@Jessica</p>
        <p class="mt-2 text-sm">Développeuse web Dévoué. JavaScript, AdonisJS, PostgreSQL,React 💻</p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="px-6 py-2 border-b border-t border-gray-700 flex gap-8">
    <div>
      <span class="font-bold">150</span> <span class="text-gray-400">Abonnés</span>
    </div>
    <div>
      <span class="font-bold">180</span> <span class="text-gray-400">Abonnements</span>
    </div>
  </section>

</body>
</html> 
